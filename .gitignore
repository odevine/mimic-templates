# macOS
.DS_Store
._*

# Editors
.idea/
.vscode/
*.swp
*~

# Go workspace sum, when a local go.work is used for engine development
go.work
go.work.sum

# Source frame PSDs. These are the large source-of-truth binaries the bundles
# are built from, not the shipped artifact, so they stay out of git the same way
# they did in the engine repo
*.psd
*.psb
/psd/

# The layer PNGs a checkout may still hold from the templates that came before
# m15, which are not in the repository any more. A template in the source form,
# one with a template.json, tracks its PNGs, so it is not listed here
templates/normal/
templates/split/
templates/transform/

# Built bundles and other build output. Bundles are release assets, uploaded to
# GitHub Releases, not committed
/build/
*.mimic

# Test, coverage and profiling output
*.test
coverage.out
coverage.html
*.prof
*.pprof

# Claude Code per-user settings. Shared .claude/settings.json stays tracked
.claude/settings.local.json
